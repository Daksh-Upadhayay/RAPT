# Copy to .env and adjust. Defaults in app/core/config.py match a local Homebrew Postgres.
# The API connects as the restricted role rapt_app (row-level security applies); migrations,
# the operator CLI and scripts use the owner connection. See README "Setup".
DATABASE_URL=postgresql+asyncpg://rapt_app@localhost:5432/rapt
ADMIN_DATABASE_URL=postgresql+asyncpg://localhost:5432/rapt
TEST_DATABASE_URL=postgresql+asyncpg://rapt_app@localhost:5432/rapt_test
TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://localhost:5432/rapt_test
APP_DB_ROLE=rapt_app

# Session tokens. Set a long random secret (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Unset: a random one per process, so everyone is signed out whenever the server restarts.
# JWT_SECRET=...
JWT_TTL_HOURS=12
COOKIE_SECURE=true

# Trained model versions to serve (directories under app/ml/artifacts/<model>/)
CATEGORY_MODEL_VERSION=v1
URGENCY_MODEL_VERSION=v4

# Knowledge-base embeddings; must produce 384-d vectors (the pgvector column size)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Put in front of search queries (not entries); use "" for a model without a query instruction
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Draft Agent LLM. DRAFT_PROVIDER=auto uses Gemini if GEMINI_API_KEY is set, else Claude if
# ANTHROPIC_API_KEY is set, else an offline placeholder draft marked [OFFLINE DRAFT].
# Free Gemini key: https://aistudio.google.com/apikey (free tier: Google may use prompts
# to improve its products - fine for this demo's synthetic tickets).
DRAFT_PROVIDER=auto
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
