# Copy to deploy/.env on the server (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -hex 32

# Public hostname (e.g. rapt-yourname.duckdns.org). "localhost" for a local test.
RAPT_DOMAIN=rapt-yourname.duckdns.org

# Database: the owner (migrations, CLI, backups) and the API's restricted role
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
APP_DB_ROLE=rapt_app

# Session signing key
JWT_SECRET=

# Draft LLMs (free tiers; see backend/.env.example). Groq is the main one.
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Gemini's free tier may train on prompts: keep GEMINI_ALLOWED_TENANTS to test tenants only
GEMINI_API_KEY=
GEMINI_ALLOWED_TENANTS=dev

# Local test only: other ports if 80/443 are taken
# HTTP_PORT=8080
# HTTPS_PORT=8443
