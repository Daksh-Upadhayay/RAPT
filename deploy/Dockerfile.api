# The API (and the ops/migrate tasks). Build context: the repo root.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    HF_HOME=/opt/hf \
    PATH=/app/backend/.venv/bin:$PATH

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv

WORKDIR /app/backend

# Dependencies first, so code changes don't reinstall them. uv's download cache lives in
# a build cache mount, so it speeds up rebuilds without ending up in the image.
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

# Bake the embedding models into the image: no downloads at startup, and the container
# never needs to reach Hugging Face
RUN python -c "from sentence_transformers import SentenceTransformer as S; S('BAAI/bge-small-en-v1.5'); S('sentence-transformers/all-MiniLM-L6-v2')"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

# The code, packages and models stay owned by root: the app only reads them, so it can't
# change its own code (and a chown here would store a second copy of every file).
RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8000
# One process: the login rate limiter and run recovery assume a single instance.
# The API port is only reachable from Caddy on the compose network, so forwarded
# headers are trusted from any address on it.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
